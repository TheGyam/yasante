<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Never merged into release, where Android's secure
  defaults apply and cleartext is refused.

  This has to be a base-config, not a per-domain one: a networkSecurityConfig
  overrides android:usesCleartextTraffic entirely, so whitelisting a single
  domain silently blocks everything else - including the Metro bundler on the
  LAN, which is served over plain HTTP.

  User certificates are trusted so a debugging proxy can inspect traffic.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
