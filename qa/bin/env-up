#!/usr/bin/env bash
# Starts the local test backend: Postgres + Redis in podman, Django on :8000, Metro on :8082.
# Usage: qa/bin/env-up <run-id>        (run-id e.g. AUTH-01-20260925-1400)
#        qa/bin/env-up --reseed <run-id>   also wipes the database and reloads seed data
# Logs land in qa/runs/<run-id>/ — server.log is evidence, never edit it.
set -euo pipefail
# A DEBUG in the caller's shell (Antigravity's had DEBUG=release) would override backend/.env.
unset DEBUG

QA="$(cd "$(dirname "$0")/.." && pwd)"
REPO="$(dirname "$QA")"
PY="$QA/.venv/bin/python"

RESEED=0
if [[ "${1:-}" == "--reseed" ]]; then RESEED=1; shift; fi
RUN="${1:?usage: env-up [--reseed] <run-id>}"
OUT="$QA/runs/$RUN"
mkdir -p "$OUT"

# 1. Containers (podman; there is no docker on this machine).
start_container() { # name image port extra-args...
  local name=$1 image=$2 port=$3; shift 3
  if ! podman container exists "$name"; then
    podman run -d --name "$name" -p "127.0.0.1:$port:$port" "$@" "$image" >/dev/null
  elif [[ "$(podman inspect -f '{{.State.Running}}' "$name")" != "true" ]]; then
    podman start "$name" >/dev/null
  fi
}
start_container yasante-qa-db docker.io/library/postgres:16-alpine 5432 \
  -e POSTGRES_DB=yasante -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres
start_container yasante-qa-redis docker.io/library/redis:7-alpine 6379

for _ in $(seq 30); do
  podman exec yasante-qa-db pg_isready -h 127.0.0.1 -U postgres >/dev/null 2>&1 && break
  sleep 1
done
podman exec yasante-qa-db pg_isready -h 127.0.0.1 -U postgres >/dev/null

# 2. Backend .env (gitignored). Local-only secret, generated once.
ENV="$REPO/backend/.env"
if [[ ! -f "$ENV" ]]; then
  sed "s|^SECRET_KEY=.*|SECRET_KEY=$("$PY" -c 'import secrets;print(secrets.token_urlsafe(50))')|" \
    "$REPO/backend/.env.example" > "$ENV"
fi

cd "$REPO/backend"
if (( RESEED )); then
  "$PY" manage.py flush --no-input
fi
"$PY" manage.py migrate --no-input > "$OUT/migrate.log" 2>&1
if (( RESEED )) || [[ "$("$PY" manage.py shell -c 'from apps.accounts.models import User;print(User.objects.count())' 2>/dev/null | tail -1)" == "0" ]]; then
  "$PY" manage.py seed_db > "$OUT/seed.log" 2>&1
fi

# 3. Django. Replaces any earlier runserver so the log belongs to this run.
# A systemd user service, not `nohup … &`: some agent shells kill every child when a
# command returns, which took Metro down mid-run. A service belongs to no shell.
pkill -f "manage.py runserver 127.0.0.1:8000" 2>/dev/null || true
systemctl --user stop yasante-qa-django 2>/dev/null || true
systemctl --user reset-failed yasante-qa-django 2>/dev/null || true
: > "$OUT/server.log"
systemd-run --user --quiet --unit=yasante-qa-django --collect \
  --working-directory="$REPO/backend" \
  -p StandardOutput="append:$OUT/server.log" -p StandardError="append:$OUT/server.log" \
  "$PY" -u manage.py runserver 127.0.0.1:8000 --noreload

for _ in $(seq 20); do
  curl -s -o /dev/null http://127.0.0.1:8000/ && break
  sleep 1
done
curl -s -o /dev/null -w "backend: HTTP %{http_code} from http://127.0.0.1:8000/\n" http://127.0.0.1:8000/ \
  || { echo "backend did not start; see $OUT/server.log"; exit 1; }

echo "server log: $OUT/server.log"
echo "next: start Metro with   qa/bin/metro $RUN"
