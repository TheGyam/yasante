{
  "expo": {
    "name": "Yasante",
    "slug": "yasante",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "yasante",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8DA399"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yasante.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8DA399"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yasante.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Yasante to access your photos to track your hair progress.",
          "cameraPermission": "Allow Yasante to access your camera to take progress photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Yasante to access your camera to take progress photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#8DA399",
          "sounds": []
        }
      ],
      "expo-video",
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ff00f530-2102-4b1a-9082-6062375bf281"
      },
      "apiBaseUrl": "https://yasante.com"
    }
  }
}
