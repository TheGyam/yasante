{
  "expo": {
    "name": "Yasante",
    "slug": "yasante",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "yasante",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yasante.app",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:yasante.com",
        "applinks:www.yasante.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0709"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yasante.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "yasante.com"
            },
            {
              "scheme": "https",
              "host": "www.yasante.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Yasante to use your photos for your boards and profile picture.",
          "cameraPermission": "Allow Yasante to use your camera for your boards and profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#B8336A",
          "sounds": []
        }
      ],
      "expo-video",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-wordmark-light.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7F2F4",
          "dark": {
            "image": "./assets/splash-wordmark-dark.png",
            "backgroundColor": "#0B0709"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "apiBaseUrl": "https://yasante.com",
      "eas": {
        "projectId": "9dbcb957-3709-4ef6-b6e0-1f5800eb2c43"
      }
    },
    "owner": "mandey",
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": false
    }
  }
}
