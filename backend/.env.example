# ──────────────────────────────────────────────
# Yasante Backend — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# Django
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yasante

# Redis (cache + Celery broker + rate limiting)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# SMS (Twilio) — leave blank to use console backend
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email (SMTP / SendGrid) — leave blank to use console backend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Yasante <noreply@yasante.com>

# Media storage — local or s3
MEDIA_STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-2

# Sentry (optional)
SENTRY_DSN=

# Push notifications: "expo" sends through Expo; anything else only logs.
PUSH_DELIVERY=log
# Expo access token for sending pushes (needed once "Enhanced security for push
# notifications" is on in Expo). Secret: never commit a real one.
EXPO_ACCESS_TOKEN=
