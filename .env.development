# Dev only. Set to true to answer API calls from src/mocks instead of a backend.
EXPO_PUBLIC_API_MOCKS=false

# The live backend on the server
EXPO_PUBLIC_API_BASE_URL=https://api.yasante.com

# Or a Django backend running on this machine (use its LAN IP for a phone)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.107:8000
